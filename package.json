{
  "name": "kayvee",
  "description": "Write data to key=val pairs, for human and machine readability",
  "version": "4.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import":  "./dist/index.js",
      "types":   "./dist/index.d.ts"
    },
    "./logger": {
      "require": "./dist/logger/logger.js",
      "import":  "./dist/logger/logger.js",
      "types":   "./dist/logger/logger.d.ts"
    },
    "./middleware": {
      "require": "./dist/middleware.js",
      "import":  "./dist/middleware.js",
      "types":   "./dist/middleware.d.ts"
    },
    "./router": {
      "require": "./dist/router/index.js",
      "import":  "./dist/router/index.js",
      "types":   "./dist/router/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "logger": ["dist/logger/logger.d.ts"],
      "middleware": ["dist/middleware.d.ts"],
      "router": ["dist/router/index.d.ts"]
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/Clever/kayvee-js"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "jsonschema": "^1.5.0",
    "morgan": "^1.10.0",
    "qs": "^6.13.0"
  },
  "devDependencies": {
    "@clever/prettier-config": "1.0.0",
    "@types/express": "^4.17.23",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonschema": "^1.1.1",
    "@types/mocha": "^10.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.0",
    "@types/qs": "^6.9.11",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "benchmark": "^2.1.1",
    "eslint": "^8.56.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-formatter-summary": "^1.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "express": "^4.18.2",
    "mocha": "^10.2.0",
    "prettier": "^3.2.5",
    "sinon": "^17.0.1",
    "split": "^1.0.0",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "underscore": "^1.8.3"
  },
  "scripts": {
    "test": "make -Br test",
    "prepublish": "make build"
  },
  "author": "Clever <tech-notify@clever.com>",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/Clever/kayvee-js/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
