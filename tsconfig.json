{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2022",
    "outDir": "./build",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["lib/**/*"],
  "exclude": ["node_modules", "build", "test"],
  "ts-node": {
    "transpileOnly": true
  }
}
